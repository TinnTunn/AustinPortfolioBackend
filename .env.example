# Copy to .env for local development. In production (Railway) set the same
# keys under the service's Variables tab. Never commit the real values.

PORT=4000

# Where the frontend lives. FRONTEND_ORIGINS is the CORS / Origin allow-list
# (comma-separated); FRONTEND_URL is where content-change webhooks are sent.
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Shared secret between the frontend server and this API (visit tracking and
# cache revalidation). A random string of at least 32 characters (shorter
# values are ignored); use the same value in the frontend's INTERNAL_API_KEY.
INTERNAL_API_KEY=

# Supabase (Project Settings → API). The service-role key bypasses RLS: keep
# it on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel. ADMIN_EMAIL must match the user you create in Supabase →
# Authentication → Users. The session secret signs the admin cookie and
# hashes visitor IPs: at least 32 random characters.
ADMIN_EMAIL=
ADMIN_SESSION_SECRET=

# Contact form emails (Resend)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# Tinn, the AI assistant (Google AI Studio → Get API key)
GEMINI_API_KEY=
